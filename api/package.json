{
  "name": "esp32-node-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Node.js para gerenciar agendas sonoras de dispositivos D1 mini com OLED.",
  "main": "index.js",
  "scripts": {
    "sync:dashboard": "node scripts/sync-dashboard.js",
    "start": "npm run sync:dashboard && node src/server.js",
    "dev": "npm run sync:dashboard && node --watch src/server.js",
    "vercel-build": "npm run sync:dashboard"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.3"
  }
}
